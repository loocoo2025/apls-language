{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apls.dev/schema/apls-cnl-diagnostic-0.1.schema.json",
  "title": "APLS CNL Diagnostic Envelope 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["diagnostics", "format", "format_version", "status"],
  "properties": {
    "diagnostics": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "format": { "const": "apls-diagnostics" },
    "format_version": { "const": "0.1" },
    "status": {
      "enum": ["accepted", "rejected", "tool_failure", "internal_failure"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "diagnostics": {
            "contains": {
              "type": "object",
              "required": ["code"],
              "properties": { "code": { "const": "APLS-T0006" } }
            }
          }
        }
      },
      "then": { "properties": { "status": { "const": "internal_failure" } } }
    },
    {
      "if": {
        "not": {
          "properties": {
            "diagnostics": {
              "contains": {
                "type": "object",
                "required": ["code"],
                "properties": { "code": { "const": "APLS-T0006" } }
              }
            }
          }
        },
        "properties": {
          "diagnostics": {
            "contains": {
              "type": "object",
              "required": ["code"],
              "properties": { "code": { "pattern": "^APLS-T[0-9]{4}$" } }
            }
          }
        }
      },
      "then": { "properties": { "status": { "const": "tool_failure" } } }
    },
    {
      "if": {
        "not": {
          "properties": {
            "diagnostics": {
              "contains": {
                "type": "object",
                "required": ["code"],
                "properties": { "code": { "pattern": "^APLS-T[0-9]{4}$" } }
              }
            }
          }
        },
        "properties": {
          "diagnostics": {
            "contains": {
              "type": "object",
              "required": ["code"],
              "properties": { "code": { "pattern": "^APLS-E[0-9]{4}$" } }
            }
          }
        }
      },
      "then": { "properties": { "status": { "const": "rejected" } } }
    },
    {
      "if": {
        "not": {
          "properties": {
            "diagnostics": {
              "contains": {
                "type": "object",
                "required": ["code"],
                "properties": { "code": { "pattern": "^APLS-[ET][0-9]{4}$" } }
              }
            }
          }
        }
      },
      "then": { "properties": { "status": { "const": "accepted" } } }
    }
  ],
  "$defs": {
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_path",
        "start_byte",
        "end_byte",
        "start_line",
        "start_column",
        "end_line",
        "end_column"
      ],
      "properties": {
        "logical_path": { "type": "string", "minLength": 1 },
        "start_byte": { "type": "integer", "minimum": 0 },
        "end_byte": { "type": "integer", "minimum": 0 },
        "start_line": { "type": "integer", "minimum": 1 },
        "start_column": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 },
        "end_column": { "type": "integer", "minimum": 1 }
      }
    },
    "candidateSymbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name", "symbol_id", "symbol_kind"],
      "properties": {
        "display_name": { "type": "string", "minLength": 1 },
        "symbol_id": { "type": "string", "minLength": 1 },
        "symbol_kind": {
          "enum": ["entity", "property", "action", "event", "state", "unit"]
        }
      }
    },
    "fixSuggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "message", "target_span"],
      "properties": {
        "kind": {
          "enum": [
            "declare_term",
            "quote_exact_term",
            "supply_value_and_unit",
            "supply_semantic_role",
            "split_sentence",
            "choose_candidate"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "target_span": {
          "oneOf": [
            { "$ref": "#/$defs/span" },
            { "type": "null" }
          ]
        }
      }
    },
    "roleFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "value_fingerprint"],
      "properties": {
        "role": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "value_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "ambiguityWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_kind", "role_fingerprints", "semantic_fingerprint"],
      "properties": {
        "frame_kind": {
          "enum": [
            "entity_declaration",
            "unit_declaration",
            "property_declaration",
            "action_declaration",
            "event_declaration",
            "alias_declaration",
            "state_declaration",
            "rule",
            "transition",
            "invariant",
            "acceptance",
            "informative_item"
          ]
        },
        "role_fingerprints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/roleFingerprint" }
        },
        "semantic_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "ambiguityPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["differing_roles", "kind", "outcome", "witnesses"],
      "properties": {
        "differing_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        },
        "kind": { "const": "ambiguity" },
        "outcome": { "const": "AMBIGUOUS" },
        "witnesses": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/ambiguityWitness" }
        }
      }
    },
    "resourcePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "limit",
        "observed",
        "resource",
        "scope",
        "sentence_index",
        "stage"
      ],
      "properties": {
        "kind": { "const": "resource_limit" },
        "limit": { "type": "integer", "minimum": 0 },
        "observed": { "type": "integer", "minimum": 1 },
        "resource": {
          "enum": [
            "single_source_bytes",
            "source_graph_bytes",
            "source_count",
            "import_depth",
            "candidate_lattice_edges",
            "complete_token_streams",
            "candidate_token_occurrences",
            "parse_candidate_syntax_nodes",
            "bound_frame_candidates",
            "typed_frame_candidates",
            "canonical_frame_candidates",
            "expression_depth",
            "public_diagnostics",
            "canonical_ir_bytes"
          ]
        },
        "scope": { "enum": ["source", "sentence", "document", "artifact"] },
        "sentence_index": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "stage": {
          "enum": [
            "load",
            "validate_unicode",
            "lattice",
            "enumerate",
            "parse",
            "bind",
            "type",
            "normalize",
            "diagnose",
            "emit"
          ]
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_symbols",
        "code",
        "fix_suggestions",
        "message",
        "missing_or_ambiguous_roles",
        "normative_rule_reference",
        "payload",
        "primary_source_span",
        "related_source_spans",
        "severity"
      ],
      "properties": {
        "candidate_symbols": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/candidateSymbol" }
        },
        "code": {
          "type": "string",
          "pattern": "^APLS-[ETW][0-9]{4}$"
        },
        "fix_suggestions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/fixSuggestion" }
        },
        "message": { "type": "string", "minLength": 1 },
        "missing_or_ambiguous_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        },
        "normative_rule_reference": { "type": "string", "minLength": 1 },
        "payload": {
          "oneOf": [
            { "$ref": "#/$defs/ambiguityPayload" },
            { "$ref": "#/$defs/resourcePayload" },
            { "type": "null" }
          ]
        },
        "primary_source_span": {
          "oneOf": [
            { "$ref": "#/$defs/span" },
            { "type": "null" }
          ]
        },
        "related_source_spans": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/span" }
        },
        "severity": { "enum": ["error", "warning"] }
      },
      "allOf": [
        {
          "if": { "properties": { "code": { "const": "APLS-E1310" } } },
          "then": {
            "properties": {
              "payload": { "$ref": "#/$defs/ambiguityPayload" },
              "primary_source_span": { "$ref": "#/$defs/span" },
              "severity": { "const": "error" }
            }
          }
        },
        {
          "if": { "properties": { "code": { "const": "APLS-T0007" } } },
          "then": {
            "properties": {
              "payload": { "$ref": "#/$defs/resourcePayload" },
              "severity": { "const": "error" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "not": { "enum": ["APLS-E1310", "APLS-T0007"] }
              }
            }
          },
          "then": { "properties": { "payload": { "type": "null" } } }
        },
        {
          "if": { "properties": { "code": { "pattern": "^APLS-E[0-9]{4}$" } } },
          "then": {
            "properties": {
              "primary_source_span": { "$ref": "#/$defs/span" },
              "severity": { "const": "error" }
            }
          }
        },
        {
          "if": { "properties": { "code": { "pattern": "^APLS-T[0-9]{4}$" } } },
          "then": { "properties": { "severity": { "const": "error" } } }
        },
        {
          "if": { "properties": { "code": { "pattern": "^APLS-W[0-9]{4}$" } } },
          "then": { "properties": { "severity": { "const": "warning" } } }
        }
      ]
    }
  }
}
